    "preview.media.favorite-relay.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"قناة خيالية تبث عروضًا تعاونية بين استوديوهات صغيرة حول العالم."}},"de":{"stringUnit":{"state":"translated","value":"Ein fiktiver Sender mit gemeinschaftlichen Aufführungen kleiner Studios aus aller Welt."}},"en":{"stringUnit":{"state":"translated","value":"A fictional channel carrying collaborative performances between small studios around the world."}}}},
