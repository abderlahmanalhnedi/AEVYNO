    "preview.media.series-midnight.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"تتابع يوميات ميدانية اصطناعية ست ليالٍ من المراقبة الدقيقة في مدينة بعد حلول الظلام."}},"de":{"stringUnit":{"state":"translated","value":"Ein synthetisches Feldtagebuch begleitet sechs Nächte sorgfältiger Beobachtung in einer Stadt nach Einbruch der Dunkelheit."}},"en":{"stringUnit":{"state":"translated","value":"A synthetic field journal follows six nights of careful observation in a city after dark."}}}},
