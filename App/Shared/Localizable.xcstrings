    "preview.media.live-current.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"مختبر مباشر خيالي تراجع فيه فرق صغيرة الأشياء والمساحات وتجارب التفاعل."}},"de":{"stringUnit":{"state":"translated","value":"Ein fiktives Live-Labor, in dem kleine Teams Objekte, Räume und Interaktionsexperimente besprechen."}},"en":{"stringUnit":{"state":"translated","value":"A fictional live lab where small teams review objects, spaces and interaction experiments."}}}},
