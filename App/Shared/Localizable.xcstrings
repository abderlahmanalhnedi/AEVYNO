    "preview.media.live-horizon.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"قناة عرض أصلية تقدم تقارير خيالية موجزة من أنحاء الأفق."}},"de":{"stringUnit":{"state":"translated","value":"Ein origineller Demosender mit kurzen fiktiven Meldungen aus allen Richtungen des Horizonts."}},"en":{"stringUnit":{"state":"translated","value":"An original demonstration channel presenting concise fictional dispatches from across the horizon."}}}},
