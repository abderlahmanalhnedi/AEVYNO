    "preview.media.movie-meadow.subtitle" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"دراما"}},"de":{"stringUnit":{"state":"translated","value":"Drama"}},"en":{"stringUnit":{"state":"translated","value":"Drama"}}}},
    "preview.media.movie-meadow.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"تتواصل محطتان ميدانيتان بعيدتان بأنماط من الضوء عبر سهل أخضر لا ينتهي."}},"de":{"stringUnit":{"state":"translated","value":"Zwei entfernte Feldstationen kommunizieren durch Lichtmuster über eine endlose grüne Ebene."}},"en":{"stringUnit":{"state":"translated","value":"Two distant field stations communicate through patterns of light across an endless green plain."}}}},
