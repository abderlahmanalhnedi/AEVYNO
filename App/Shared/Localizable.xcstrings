    "preview.media.favorite-compass.subtitle" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"مسلسل محفوظ"}},"de":{"stringUnit":{"state":"translated","value":"Gespeicherte Serie"}},"en":{"stringUnit":{"state":"translated","value":"Saved series"}}}},
    "preview.media.favorite-compass.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يقارن أربعة مسافرين الغرف التي تكشفها بوصلاتهم في قلب مشهد طبيعي متحول."}},"de":{"stringUnit":{"state":"translated","value":"Vier Reisende vergleichen die Räume, die ihre Kompasse im Zentrum einer sich wandelnden Landschaft zeigen."}},"en":{"stringUnit":{"state":"translated","value":"Four travelers compare the rooms their compasses reveal at the center of a shifting landscape."}}}},
