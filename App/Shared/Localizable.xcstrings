    "preview.media.movie-lagoon.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يقود عبور ليلي فوق مياه كالزجاج طاقمًا صغيرًا نحو مدينة لا تظهر إلا عند الفجر."}},"de":{"stringUnit":{"state":"translated","value":"Eine nächtliche Fahrt über spiegelglattes Wasser führt eine kleine Crew zu einer Stadt, die nur im Morgengrauen erscheint."}},"en":{"stringUnit":{"state":"translated","value":"A midnight transit across glasslike water leads a small crew toward a city that appears only at dawn."}}}},
