    "preview.media.favorite-afterglow.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يدرس مرمم اللون الذي خلّفه عمل فني اختفى والحكايات المحفوظة داخله."}},"de":{"stringUnit":{"state":"translated","value":"Ein Restaurator untersucht die Farbe, die eine verschwundene Installation hinterlassen hat, und die darin bewahrten Geschichten."}},"en":{"stringUnit":{"state":"translated","value":"A conservator studies the color left behind by a vanished installation and the stories held within it."}}}},
