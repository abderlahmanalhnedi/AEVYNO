    "preview.media.live-field.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"بث استوديو اصطناعي متواصل يقدم جلسات هادئة مع مصممين وصنّاع وموسيقيين."}},"de":{"stringUnit":{"state":"translated","value":"Ein fortlaufender synthetischer Studiofeed mit ruhigen Sitzungen von Designern, Kreativen und Musikern."}},"en":{"stringUnit":{"state":"translated","value":"A continuous synthetic studio feed featuring calm sessions with designers, makers and musicians."}}}},
