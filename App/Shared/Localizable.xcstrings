    "preview.media.continue-harbor.subtitle" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"متبقي 18 دقيقة"}},"de":{"stringUnit":{"state":"translated","value":"Noch 18 Min."}},"en":{"stringUnit":{"state":"translated","value":"18 min remaining"}}}},
    "preview.media.continue-harbor.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"تتحول دراسة ساحلية هادئة إلى سجل مضيء للحركة والذاكرة والمد والجزر المتغير."}},"de":{"stringUnit":{"state":"translated","value":"Eine ruhige Küstenstudie wird zu einer leuchtenden Aufzeichnung von Bewegung, Erinnerung und wechselnden Gezeiten."}},"en":{"stringUnit":{"state":"translated","value":"A quiet coastal study becomes a luminous record of movement, memory and changing tides."}}}},
