    "preview.media.movie-vector.subtitle" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"خيال علمي"}},"de":{"stringUnit":{"state":"translated","value":"Science-Fiction"}},"en":{"stringUnit":{"state":"translated","value":"Science fiction"}}}},
    "preview.media.movie-vector.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يتتبع طيار أبحاث متجهًا صامتًا عبر سماء ليلية اصطناعية ويجد طريقًا ثانيًا غير متوقع إلى الوطن."}},"de":{"stringUnit":{"state":"translated","value":"Ein Forschungspilot verfolgt einen stillen Vektor durch einen synthetischen Nachthimmel und findet einen unerwarteten zweiten Heimweg."}},"en":{"stringUnit":{"state":"translated","value":"A research pilot traces a silent vector through a synthetic night sky and finds an unexpected second route home."}}}},
    "preview.media.movie-vector.title" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"المتجه الصامت 29"}},"de":{"stringUnit":{"state":"translated","value":"Stiller Vektor 29"}},"en":{"stringUnit":{"state":"translated","value":"Silent Vector 29"}}}},
    "preview.media.series-aurora.subtitle" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"الموسم 1"}},"de":{"stringUnit":{"state":"translated","value":"Staffel 1"}},"en":{"stringUnit":{"state":"translated","value":"Season 1"}}}},
    "preview.media.series-aurora.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يفهرس فريق من المراقبين ألوانًا مستحيلة تظهر فوق محطة شمالية نائية."}},"de":{"stringUnit":{"state":"translated","value":"Ein Beobachtungsteam katalogisiert unmögliche Farben über einer abgelegenen nördlichen Station."}},"en":{"stringUnit":{"state":"translated","value":"A team of observers catalogs impossible colors appearing over a remote northern station."}}}},
    "preview.media.series-aurora.title" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"فهرس الشفق 23"}},"de":{"stringUnit":{"state":"translated","value":"Auroraindex 23"}},"en":{"stringUnit":{"state":"translated","value":"Aurora Index 23"}}}},
    "preview.media.series-ember.subtitle" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"الموسم 2"}},"de":{"stringUnit":{"state":"translated","value":"Staffel 2"}},"en":{"stringUnit":{"state":"translated","value":"Season 2"}}}},
    "preview.media.series-ember.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يعيد الجيران بناء حي تجريبي بينما يتتبعون مصدر ضوء دافئ تحت شوارعه."}},"de":{"stringUnit":{"state":"translated","value":"Nachbarn bauen einen experimentellen Bezirk wieder auf und suchen zugleich die Quelle eines warmen Lichts unter seinen Straßen."}},"en":{"stringUnit":{"state":"translated","value":"Neighbors rebuild an experimental district while tracing the source of a warm light beneath its streets."}}}},
    "preview.media.series-ember.title" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"حي الجمر 14"}},"de":{"stringUnit":{"state":"translated","value":"Glutbezirk 14"}},"en":{"stringUnit":{"state":"translated","value":"Ember District 14"}}}},
