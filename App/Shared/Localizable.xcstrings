    "preview.media.movie-solar.subtitle" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"وثائقي"}},"de":{"stringUnit":{"state":"translated","value":"Dokumentation"}},"en":{"stringUnit":{"state":"translated","value":"Documentary"}}}},
    "preview.media.movie-solar.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"ترسم بعثة متخيلة خرائط لأنسجة وإيقاعات وهندسة هادئة لنظام شمسي مصغر."}},"de":{"stringUnit":{"state":"translated","value":"Eine imaginäre Expedition kartiert Texturen, Rhythmen und die stille Geometrie eines Miniatursonnensystems."}},"en":{"stringUnit":{"state":"translated","value":"An imagined expedition maps the textures, rhythms and quiet geometry of a miniature solar system."}}}},
