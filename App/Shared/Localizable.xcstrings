    "preview.media.continue-cinder.subtitle" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"الحلقة 4"}},"de":{"stringUnit":{"state":"translated","value":"Folge 4"}},"en":{"stringUnit":{"state":"translated","value":"Episode 4"}}}},
    "preview.media.continue-cinder.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يكتشف أمين أرشيف أطلسًا مرسومًا باليد يبدو أنه يعيد رسم المدينة كل ليلة."}},"de":{"stringUnit":{"state":"translated","value":"Ein Archivar entdeckt einen handgezeichneten Atlas, der die Stadt jede Nacht neu zu zeichnen scheint."}},"en":{"stringUnit":{"state":"translated","value":"An archivist uncovers a hand-drawn atlas that seems to redraw the city each night."}}}},
