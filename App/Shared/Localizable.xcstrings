    "preview.media.movie-vector.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يتتبع طيار أبحاث متجهًا صامتًا عبر سماء ليلية اصطناعية ويجد طريقًا ثانيًا غير متوقع إلى الوطن."}},"de":{"stringUnit":{"state":"translated","value":"Ein Forschungspilot verfolgt einen stillen Vektor durch einen synthetischen Nachthimmel und findet einen unerwarteten zweiten Heimweg."}},"en":{"stringUnit":{"state":"translated","value":"A research pilot traces a silent vector through a synthetic night sky and finds an unexpected second route home."}}}},
