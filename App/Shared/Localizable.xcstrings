    "preview.media.continue-orbit.summary" : {"extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يتتبع رسّام خرائط إشارة متكررة وراء حافة أرشيف مداري رُسم بعناية."}},"de":{"stringUnit":{"state":"translated","value":"Ein Kartograf folgt einem wiederkehrenden Signal über den Rand eines sorgfältig kartierten Orbitalarchivs hinaus."}},"en":{"stringUnit":{"state":"translated","value":"A cartographer follows a repeating signal beyond the edge of a carefully mapped orbital archive."}}}},
